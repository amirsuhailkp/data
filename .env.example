# Copy this file to .env and fill in what you're using. The CLI loads it
# automatically (via python-dotenv) if it's present in the current directory —
# no need to $env:/export these every time you open a new terminal.
#
# Only fill in the section for the backend you're actually using; leave the
# rest blank or delete it.

# --- LLM backend ---
# auto (default) | ollama | freellmapi | groq | gemini | hybrid | mock
# NOTE: the value is validated — there is no backend called "api"; use
# "freellmapi" for the freellmapi gateway.
LLM_BACKEND=groq

# freellmapi (local multi-provider router/gateway) — https://github.com/tashfeenahmed/freellmapi
# Run it locally first (default: `docker compose up`, listens on localhost:3001), then
# get a unified key from its dashboard's Keys page. It fans requests out across whichever
# free-tier providers you've registered behind it (Groq, Gemini, Cerebras, Mistral,
# OpenRouter, etc.) and fails over between them itself when one hits a rate limit — a good
# fix if a single provider's free-tier cap (e.g. Groq 429s) is the bottleneck.
# With LLM_BACKEND=freellmapi, if the container isn't reachable (or the key isn't set),
# databroker automatically falls back to local Ollama (if it's running), so a Docker
# restart doesn't hard-crash your next research run.
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=
# auto (default, follows whatever chain is active on the dashboard) |
# auto:<profile-name> (a named fallback chain you built on the Fallback page —
#   e.g. create one with ONLY Groq + Cerebras models enabled, in this order:
#   cerebras/gpt-oss-120b, groq/openai/gpt-oss-120b, cerebras/zai-glm-4.7,
#   groq/llama-3.3-70b-versatile — then set FREELLMAPI_MODEL=auto:<that name>) |
# a specific catalog model id (e.g. groq/openai/gpt-oss-120b)
FREELLMAPI_MODEL=auto

# Groq (free tier) — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama (fully local) — https://ollama.com, then `ollama pull <model>`
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# --- Search backend ---
# duckduckgo (default) | tavily | mock
SEARCH_BACKEND=duckduckgo
TAVILY_API_KEY=

# --- Social/community intelligence (Phase 4, opt-in) ---
# off (default) | reddit | hackernews | both
SOCIAL_BACKEND=off
REDDIT_SUBREDDITS=stocks,investing

# Reddit OAuth (recommended over the unauthenticated fallback — higher and
# more predictable rate limit). Register a free app at
# reddit.com/prefs/apps (type "script") to get a client_id/client_secret.
# Single app: ~100 req/min. To pool several apps for higher combined
# throughput, use the numbered form instead (REDDIT_CLIENT_ID_1/_2/_3...) —
# leave this single pair blank if you're using the numbered pool below.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Pooled Reddit apps (optional) — each free app gets its own ~100 req/min
# budget; 3 registered apps here gives roughly 300 req/min combined. Add as
# many numbered pairs as you've registered; delete unused ones.
# REDDIT_CLIENT_ID_1=
# REDDIT_CLIENT_SECRET_1=
# REDDIT_CLIENT_ID_2=
# REDDIT_CLIENT_SECRET_2=
# REDDIT_CLIENT_ID_3=
# REDDIT_CLIENT_SECRET_3=

# --- Real-time financial/trading platforms (opt-in, "first line" sources) ---
# off (default) | comma-separated list of: sec, finnhub, stocktwits, alpaca, alphavantage
# e.g. FINANCIAL_BACKEND=sec,finnhub,stocktwits,alpaca,alphavantage combines all five
FINANCIAL_BACKEND=off

# SEC EDGAR (backend: sec) — free, no API key needed. SEC's fair-access
# policy asks for a real contact string in the User-Agent; set an email here.
# Still works without it, just less politely.
SEC_EDGAR_CONTACT=

# Finnhub (backend: finnhub) — free tier (~60 calls/min) at finnhub.io.
# If left blank, the finnhub backend is silently skipped (not a crash).
FINNHUB_API_KEY=

# Alpaca (backend: alpaca) — free, real-time Benzinga-sourced news, pushed
# close to publication time (the fastest "first line" source this tool has —
# meant for day trading, where a search-engine crawl delay is too slow).
# Needs a free PAPER trading account at alpaca.markets (email + MFA, no
# ID/KYC or funding needed for paper-only) to generate a key/secret pair.
# If either is left blank, the alpaca backend is silently skipped.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Alpha Vantage News & Sentiment (backend: alphavantage) — free, NASDAQ-
# licensed, and every article gets an AI-assigned bullish/bearish sentiment
# label (overall AND per-ticker). Get a free key at alphavantage.co.
# IMPORTANT: the free tier is capped at 25 requests/day TOTAL on the
# account (not per-ticker). Because of that, Alpha Vantage defaults to
# CONFIRM mode (below) rather than being polled like the other sources.
# If left blank, Alpha Vantage is skipped entirely in both modes.
ALPHA_VANTAGE_API_KEY=

# How Alpha Vantage is used. confirm (default) | continuous | off
#   confirm    = NOT polled on a schedule. Spends one call only when some
#                OTHER source (SEC/Alpaca/Finnhub/StockTwits/Reddit) already
#                surfaced something that cleared the importance bar, to check
#                whether an independent source reports it too. The alert then
#                says whether it was corroborated. At ~25 notable events/day
#                you'd still be inside the free cap — so this is safe to run
#                alongside 24/7 fast polling.
#   continuous = the old behavior: polled every sweep like any other source.
#                Requires `alphavantage` in FINANCIAL_BACKEND as well. Only
#                sensible for once-daily sweeps; fast polling exhausts it in
#                minutes.
#   off        = key set but Alpha Vantage unused.
ALPHA_VANTAGE_MODE=confirm

# --- Chart/technical data (opt-in) — deterministic price/volume indicators
# (SMA, RSI, volatility, recent range) computed from real historical bars and
# given to the LLM as CONTEXT for its report, never as something for the LLM
# to calculate itself, and at ZERO extra LLM calls (the numbers are plain
# arithmetic, done here in Python). off (default) | alpaca
#   alpaca = reuses ALPACA_API_KEY_ID/ALPACA_API_SECRET_KEY, free IEX-feed
#            historical bars. Skipped without those credentials.
TECHNICALS_BACKEND=off

# --- Market discovery (opt-in) — the `discover` command scans the market
# for symbols you are NOT already watching that show unusual activity, and
# proposes them as watchlist candidates. Unlike everything else here, this
# is market-wide rather than ticker-first.
# off (default) | comma-separated list of: alpaca | stocktwits
#   alpaca     = most-actives + top gainers/losers screener. Reuses
#                ALPACA_API_KEY_ID/ALPACA_API_SECRET_KEY; skipped without them.
#   stocktwits = trending symbols. No key needed. Weak signal on its own —
#                it counts mainly as corroboration for the other two.
# A symbol must be flagged by enough independent signals to clear
# `discover --min-score` (default 3) before it costs an LLM call, so a
# whole market scan costs ONE call, not one per symbol.
DISCOVER_BACKEND=off

# --- Alerts (opt-in) — push a Telegram message whenever `sweep`/`watch-loop`
# finds something genuinely new (medium+ importance). Nothing is ever sent
# twice — the digest logic marks each event notified before returning.
# off (default) | telegram | mock
NOTIFY_BACKEND=off

# Telegram (backend: telegram) — free, instant. Setup (all inside Telegram):
#   1. Message @BotFather -> /newbot -> follow prompts -> copy the token it gives you.
#   2. Open a chat with your new bot and send it any message (bots can't message first).
#   3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates in a browser — your
#      numeric chat id is under message.chat.id in the JSON it returns.
# If either is left blank, the telegram backend is silently skipped (no alerts sent).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Tuning (all optional, sane defaults if omitted) ---
# MAX_SEARCH_HITS_PER_QUESTION=6
# MAX_FETCH_CHARS=1500
# RESEARCH_MAX_SUBQUESTIONS=6
# MAX_SOCIAL_HITS_PER_QUESTION=3

# --- Browser agent (dynamic navigation, opt-in) ---
# static (default) | browser — see README "Browser agent" section
FETCHER_BACKEND=static
